{
  "name": "tempmail",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready, Cloudflare-native temporary email service (Workers + D1 + R2 + Email Routing).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests data",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tempmail-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tempmail-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^4.20260702.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "wrangler": "4.72.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
